# PostgreSQL development configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=KSquare
DATABASE_USER=postgres
DATABASE_PASSWORD=
FRONTEND_ORIGIN=http://localhost:4200

# Authentication (generate long random values; never commit real values)
AUTH_OTP_PEPPER=
ADMIN_SETUP_KEY=

# Cloudflare R2 (never commit real credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET_NAME=ksquare-media
R2_PUBLIC_BASE_URL=https://<public-domain>
R2_PRIVATE_BUCKET_NAME=ksquare-private-media

# PayPal Checkout: sandbox first. Keep secrets on the backend.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_RETURN_BASE_URL=http://localhost:4200

ETSY_API_KEY=

ETSY_SHARED_SECRET=

ETSY_SHOP_ID=

OTP_EMAIL_PROVIDER=resend
RESEND_API_KEY=
OTP_EMAIL_FROM=
